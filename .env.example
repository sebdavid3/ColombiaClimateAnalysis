# Copy to .env and fill values. Do NOT commit real secrets.

# PostgreSQL connection string
# For Supabase, include sslmode or set DB_SSL=true
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Force SSL for asyncpg if your DB requires it (Supabase)
DB_SSL=true

# Comma-separated list of allowed frontend origins for CORS
# Example: https://your-streamlit-app.streamlit.app,https://mydomain.com
FRONTEND_CORS_ORIGINS=

# Frontend app can override API base URL (used by Streamlit locally)
API_BASE_URL=
